---
// 文档根地址按浏览器语言进入中文或英文文档。
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ base }}>
      location.replace(base + (navigator.language.toLowerCase().startsWith("zh") ? "zh-cn/" : "en/"))
    </script>
  </head>
</html>
