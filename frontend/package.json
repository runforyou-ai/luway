{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development && npm run build:messenger && vite build --config vite.docs.config.ts",
    "build": "tsc && vite build --mode production && npm run build:messenger && vite build --config vite.docs.config.ts",
    "preview": "vite preview",
    "build:messenger": "vite build --config vite.messenger.config.ts && vite build --config vite.messenger-realtime.config.ts",
    "build:docs": "vite build --config vite.docs.config.ts",
    "lint": "biome lint src"
  },
