# Wails Server Mode Dockerfile
# Multi-stage build for a minimal image.
#
# Defaults produce a pure-Go, fully static binary on a distroless/static base:
# the smallest, most secure image, and correct for the default (CGO-free) app.
#
# If your app needs CGO, override the build args, e.g.:
#   docker build --build-arg CGO_ENABLED=1 \
#                --build-arg GO_IMAGE=golang:1.27-bookworm \
#                --build-arg RUNTIME_IMAGE=gcr.io/distroless/base-debian12 \
#                -f build/docker/Dockerfile.server .
# CGO needs a C toolchain in the builder and a libc in the runtime image; keep
# the builder and runtime libc compatible (a glibc builder -> a glibc runtime).
# The Taskfile passes these through: task build:docker CGO_ENABLED=1 GO_IMAGE=... RUNTIME_IMAGE=...
# 通过 wails3 task build:docker 先构建 frontend/dist、internal/publicweb/dist 和 internal/productdocs/dist/site。
# 直接调用 docker build 前须准备这些资源，CI 的前端 build 脚本会一并生成；未构建文档样式时 /docs/ 页面不带样式。
# 发布清单与客户端文件通过构建上下文 release 传入（--build-context release=<目录>），目录含与 APP_VERSION 同版本的 release.json、release.json.sig 与 clients 子目录；未传入时镜像不提供客户端下载。

ARG GO_IMAGE=golang:1.27-alpine
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12
ARG CGO_ENABLED=0

# 发布清单与客户端目录，未通过构建上下文传入时为空。
FROM scratch AS release

# Go 编译缓存归档，通过构建上下文 go-cache 传入。
FROM scratch AS go-cache

# Build stage
# 构建阶段运行在构建机平台，按 TARGETOS/TARGETARCH 交叉编译；CGO_ENABLED=1 时目标平台须与构建机一致。
FROM --platform=${BUILDPLATFORM} ${GO_IMAGE} AS builder
ARG CGO_ENABLED
ARG TARGETOS
ARG TARGETARCH
# 写入程序的版本号。
ARG APP_VERSION=dev

WORKDIR /app

# Install build dependencies: git always; a C compiler only when CGO is enabled.
# Supports both apk (alpine) and apt (debian/bookworm) base images.
RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache git $([ "$CGO_ENABLED" = "1" ] && echo gcc musl-dev); \
    else \
        apt-get update && apt-get install -y --no-install-recommends git $([ "$CGO_ENABLED" = "1" ] && echo gcc libc6-dev) && rm -rf /var/lib/apt/lists/*; \
    fi

# 模块下载独立成层，按 go.mod 与 go.sum 复用。
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the production server binary.
# - server,production tags: HTTP server mode with production code paths (no dev
#   logger/asset middleware), matching the desktop production build.
# - CGO_ENABLED defaults to 0 for a fully static binary (distroless/static);
#   override with --build-arg CGO_ENABLED=1 (see header) for CGO apps.
# 编译缓存从归档恢复，本机连续构建共用 BuildKit 缓存挂载。
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,from=go-cache,target=/cache \
    if [ -f /cache/build.tar ]; then tar -xf /cache/build.tar -C /root/.cache/go-build; fi && \
    CGO_ENABLED=${CGO_ENABLED} GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -tags server,production -trimpath -buildvcs=false -ldflags="-s -w -X github.com/runforyou-ai/luway/internal/common/buildinfo.Version=${APP_VERSION}" -o server ./cmd/server

# 缓存导出继承本次构建并合并传入的归档。
FROM builder AS go-cache-archive
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,from=go-cache,target=/cache \
    if [ -f /cache/build.tar ]; then tar -xf /cache/build.tar -C /root/.cache/go-build; fi && \
    tar -cf /build.tar -C /root/.cache/go-build .

# CI 通过本地输出收集单个编译缓存归档。
FROM scratch AS go-cache-export
COPY --from=go-cache-archive /build.tar /build.tar

# Runtime stage - minimal image
FROM ${RUNTIME_IMAGE}

# 发布清单与客户端目录位于程序所在目录。
COPY --from=builder /app/server /server
COPY --from=release / /

# auto 模式使用 80/443；8080 为 server.port 的默认端口。
EXPOSE 80 443 8080

# 配置文件为 /etc/<程序名>/server.yaml，数据目录为 /var/lib/<程序名>，部署时挂载配置目录与数据卷。
ENV XDG_CONFIG_HOME=/etc XDG_DATA_HOME=/var/lib

# Run the server
ENTRYPOINT ["/server", "run"]
