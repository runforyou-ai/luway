COMPOSE_PROJECT_NAME=luway

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_HTTPS_PORT=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=luway
POSTGRES_PASSWORD=luway
POSTGRES_DB=main
POSTGRES_SSLMODE=disable

# 留空使用内嵌 NATS；填写则连接已初始化的外部单节点或集群。
NATS_URL=

# 程序组成专属的启动配置项，逗号分隔的 名称=取值，写入配置文件的 extension.<名称>。
SERVER_EXTENSION=

WAILS_VITE_PORT=9245

WAILS_MCP_HOST=127.0.0.1
WAILS_MCP_PORT=9099
WAILS_MCP_TIMEOUT=30000

# 文件测试连接共用的开发 S3，每项测试创建并清理独立桶。
TEST_S3_ENDPOINT=http://127.0.0.1:9000
TEST_S3_ACCESS_KEY_ID=luway-test
TEST_S3_SECRET_ACCESS_KEY=luway-test-secret
