# 部署地址：各端连接与 Web 访问的公开地址，服务端生成的对外链接以它为根地址
PUBLIC_URL=http://localhost:8080
# 部署名称：桌面端与移动端连接服务器后展示，为空时展示部署地址
DEPLOYMENT_NAME=
# 自托管部署是否允许任何人在登录页注册账号，托管部署不可开启
REGISTRATION_OPEN=false

# 服务端内部端口
WAILS_SERVER_HOST=127.0.0.1
WAILS_SERVER_PORT=8080

# 直接管理证书使用 auto，外层代理或 CDN 使用 external，关闭 HTTPS 使用 off。
TLS_MODE=off
TLS_ACME_EMAIL=

# 桌面开发与 MCP
WAILS_VITE_PORT=9245
WAILS_MCP_HOST=127.0.0.1
WAILS_MCP_PORT=9099
WAILS_MCP_TIMEOUT=30000

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=cervi
POSTGRES_PASSWORD=cervi
POSTGRES_DB=main
POSTGRES_SSLMODE=disable

# NATS
NATS_URL=nats://127.0.0.1:4222
NATS_NAMESPACE=main

# 文件与本地数据
FILE_STORAGE_PATH=data/files
DESKTOP_DATA_DIR=data/desktop

# 对象存储
S3_ENABLED=false
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_PUBLIC_BASE_URL=https://files.example.com
# S3_REGION=us-east-1
# S3_BUCKET=luway
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# 邮件发送（主机为空时关闭）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=support@example.com
